# Telegram (my.telegram.org -> API development tools)
TG_API_ID=1234567
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Путь к файлу сессии (по умолчанию data/optics.session).
TG_SESSION=data/optics
# Либо StringSession из scripts/login.py — тогда файл не нужен (удобно для VPS/докера)
TG_SESSION_STRING=

# Supabase -> Project Settings -> Database -> Connection string -> URI
# Бери Session pooler (порт 5432) — он IPv4-совместимый.
# Если используешь Transaction pooler (6543), всё тоже работает: asyncpg
# поднимается с statement_cache_size=0, см. src/chat_parser/db.py
DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

ANTHROPIC_API_KEY=sk-ant-...

# Соль для хэширования user_id. Сгенерируй один раз и НЕ меняй:
#   python -c "import secrets; print(secrets.token_hex(16))"
# Смена соли разорвёт связь сигналов с авторами в уже собранных данных.
AUTHOR_SALT=change-me

MODEL_EXTRACT=claude-opus-5
MODEL_SYNTH=claude-opus-5
EXTRACT_CONCURRENCY=4
INGEST_PAUSE=1.2
