# ============ Telegram: аккаунт-сборщик (MTProto) ============
# НЕОБЯЗАТЕЛЬНО. Нужно только для автоматической выгрузки из Telegram.
# Пока их нет, историю можно залить вручную, без всякого риска:
#   Telegram Desktop -> чат -> ⋮ -> Экспорт истории чата -> JSON
#   chat-parser import-json result.json
#
# Когда понадобится автосбор: my.telegram.org -> API development tools.
# Заводи ОТДЕЛЬНЫЙ аккаунт, не основной: за массовую выгрузку банят.
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/optics
# Строка из scripts/login.py — удобнее файла сессии на сервере
TG_SESSION_STRING=

# ============ Прокси для Telegram ============
# Нужен, если провайдер блокирует Telegram: бот падает с
# «Cannot connect to host api.telegram.org» / «превышен таймаут семафора».
# Приложение Telegram обходит блокировку само, программы — нет.
# Вариант 1: VPN на весь компьютер — тогда оставь пустым.
# Вариант 2: локальный прокси VPN-клиента (порт в его настройках):
#   TG_PROXY=socks5://127.0.0.1:10808
#   TG_PROXY=http://127.0.0.1:10809
# Используется и ботом, и автовыгрузкой. LLM и Supabase ходят напрямую.
TG_PROXY=

# ============ Telegram: бот-панель ============
# Токен у @BotFather. Бот НЕ читает историю чатов — он только панель управления.
TG_BOT_TOKEN=
# Кому можно им командовать. Без этого ботом управлял бы кто угодно.
# Свой id узнать: @userinfobot
TG_ADMIN_IDS=123456789

# ============ Supabase ============
# Project Settings -> Database -> Connection string -> URI
# Бери Session pooler (порт 5432): он IPv4-совместимый. Прямое подключение
# (хост db.<ref>.supabase.co) у новых проектов работает только по IPv6 и
# с обычного домашнего интернета даёт «getaddrinfo failed».
# Supabase -> кнопка Connect вверху проекта -> Method: Session pooler.
# Логин там вида postgres.<ref>, хост — …pooler.supabase.com.
DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ============ LLM (любой OpenAI-совместимый шлюз) ============
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=
# ТОЧНЫЙ id модели смотри командой `chat-parser models` — угадывать нельзя,
# неверная строка приведёт к 404 на каждом запросе.
LLM_MODEL=
# Модель для кластеризации и карточек. Пусто -> та же, что LLM_MODEL.
LLM_MODEL_SYNTH=
# auto | json_schema | json_object | text
# auto сам подберёт режим и напечатает его в `chat-parser doctor`;
# определившийся режим можно зафиксировать здесь, чтобы не тратить попытки.
LLM_JSON_MODE=auto
# Параметры конкретного провайдера в виде JSON, уходят в запрос как есть.
# Нужно, например, чтобы выключить рассуждения у «думающих» моделей, если
# `chat-parser llm-test` показывает, что они съедают весь лимит токенов.
# Точное имя параметра смотри в документации шлюза. Пример:
#   LLM_EXTRA_BODY={"enable_thinking": false}
LLM_EXTRA_BODY=
# Цена за 1 млн токенов запроса и ответа — нужна только скрытой команде
# бота /usage, чтобы кроме токенов показывать деньги. 0 — не показывать.
LLM_PRICE_IN=0
LLM_PRICE_OUT=0

# ============ Прочее ============
# Соль для хэширования user_id. Сгенерируй ОДИН раз и не меняй:
#   python -c "import secrets; print(secrets.token_hex(16))"
AUTHOR_SALT=change-me

INGEST_PAUSE=1.2
EXTRACT_CONCURRENCY=4
# Лимит ответа на тред. «Думающая» модель изредка рассуждает дольше —
# такой тред повторяется один раз с лимитом побольше.
EXTRACT_MAX_TOKENS=8000
EXTRACT_MAX_TOKENS_RETRY=24000
# Сколько сигналов уходит в модель за один проход кластеризации.
# Уменьшай, если у модели маленький контекст.
CLUSTER_BATCH=120
# Час UTC для суточного прогона из бота
DAILY_RUN_HOUR_UTC=6
# Часовой пояс, в котором бот показывает время: часы от UTC (Москва — 3)
DISPLAY_UTC_OFFSET=3
# /run спрашивает подтверждение, если в очереди больше стольких тредов
BOT_CONFIRM_THRESHOLD=50
# Ночной прогон разбирает не больше стольких тредов за раз
AUTO_EXTRACT_LIMIT=200
# Сколько сохранённых чатов подключать за раз и пауза между вступлениями (с)
JOIN_PER_RUN=5
JOIN_PAUSE=20
